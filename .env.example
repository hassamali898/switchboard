# Fallback only. Switchboard stores tokens in the OS keychain
# (python -m watcher.auth slack / google). Copy to .env only on a machine
# without a keychain. .env is git-ignored. Never commit real values.

SLACK_APP_TOKEN=xapp-...
SLACK_USER_TOKEN=xoxp-...

# Path to the Google OAuth client JSON (Desktop app, user type Internal)
GOOGLE_CLIENT_SECRETS=/path/to/client_secret.json
# Pub/Sub for Gmail push, e.g. projects/my-project/topics/gmail-switchboard
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=

# Optional: where the queue and lock file live (default ~/.switchboard)
SWITCHBOARD_HOME=
