# secrets: tokens live in the OS keychain; .env is a local fallback only
.env
.env.*
!.env.example
*.client_secret*.json
client_secret*.json

# local runtime data
.venv/
__pycache__/
*.pyc
.pytest_cache/
.switchboard/
*.db
*.lock

# generated by /plugin-types; regenerate after a Claude Code update
.claude/types/
node_modules/
.DS_Store
*.egg-info/
build/
.bootstrap.lock/

# Types the engine lays beside a hot-reloaded mod
.claude-plugin/types/
.sb-dev
.sb-dev-log*.json

# your own Claude Code settings and logs (paths, history): never shared
.claude/settings.local.json
*.log

# the promo's voice environment
promo/.venv-voice/
